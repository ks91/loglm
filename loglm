#!/usr/bin/env bash

set -euo pipefail

WORK_DIR="$(pwd -P)"
LOG_DIR="$WORK_DIR/logs"
AGENT_FILE="$WORK_DIR/.loglm_agent"
LOCAL_LLM_FILE="$WORK_DIR/.loglm_local_llm"
LOCAL_LLM_MODEL_FILE="$WORK_DIR/.loglm_local_llm_model"
LOCAL_LLM_DDG_MCP_FILE="$WORK_DIR/.loglm_local_llm_ddg_mcp"
TODAY_LOCAL="$(date +%Y%m%d)"
NOW_LOCAL="$(date +%Y%m%d-%H%M%S)"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LOGLM_HOME="${LOGLM_HOME:-$HOME/.local/share/loglm}"
SETUP_DIR=""
LOGLM_VERSION="0.3.1-dev"

SUPPORTED_AGENTS=(codex claude antigravity openclaw hermes local-llm)

usage() {
  cat <<'EOF'
Usage:
  loglm [options]
  loglm agent install <github_repo_or_url|local_repo_path> [--agent codex|claude|antigravity|openclaw|hermes|local-llm|all]
  loglm agent list [--agent codex|claude|antigravity|openclaw|hermes|local-llm|all]
  loglm agent remove <github_repo_or_url|local_repo_path> [--agent codex|claude|antigravity|openclaw|hermes|local-llm|all]
  loglm agent update <github_repo_or_url|local_repo_path|--all> [--agent codex|claude|antigravity|openclaw|hermes|local-llm|all]

Options:
  --new
      Start a new context (ignore saved session).
  --resume
      Open the agent's built-in session picker.
  --agent
      Re-select the AI coding agent (codex / claude / antigravity / openclaw / hermes / local-llm).
  --local-llm-url <url>
      Set the Anthropic-compatible local LLM gateway URL for local-llm.
      Default: http://127.0.0.1:8080
  --local-llm-model <name>
      Set the model name passed to Claude Code with --model for local-llm.
  --daily-log
      Use one log file per day (legacy behavior).
      By default, loglm creates a unique file per launch (timestamp + PID).
  -X, --dangerous
      Start the agent in dangerous/no-approval mode:
        codex  : --dangerously-bypass-approvals-and-sandbox
        claude/local-llm: --dangerously-skip-permissions
        openclaw/antigravity/hermes: no dangerous-mode flag is passed by loglm yet
  -h, --help
      Show this help.
  -v, --version
      Show loglm version.

Subcommands:
  agent ...
      Manage prompt-agent blocks in AGENTS.md / CLAUDE.md.
EOF
}

show_version() {
  printf 'loglm %s\n' "$LOGLM_VERSION"
}

resolve_setup_dir() {
  if [[ -d "$SCRIPT_DIR/setup" ]]; then
    SETUP_DIR="$SCRIPT_DIR/setup"
    return 0
  fi
  if [[ -d "$LOGLM_HOME/setup" ]]; then
    SETUP_DIR="$LOGLM_HOME/setup"
    return 0
  fi
  return 1
}

ensure_agent_installed() {
  local agent="$1"
  if [[ "$agent" == "local-llm" ]]; then
    if command -v claude > /dev/null 2>&1 && command -v llama-server > /dev/null 2>&1; then
      return 0
    fi
  elif [[ "$agent" == "antigravity" ]]; then
    if command -v agy > /dev/null 2>&1 || command -v antigravity > /dev/null 2>&1; then
      return 0
    fi
  elif command -v "$agent" > /dev/null 2>&1; then
    return 0
  fi

  if ! resolve_setup_dir; then
    echo "Error: setup scripts not found." >&2
    echo "Expected '$SCRIPT_DIR/setup' or '$LOGLM_HOME/setup'." >&2
    echo "Reinstall loglm and try again." >&2
    exit 1
  fi

  "$SETUP_DIR/ensure-agent.sh" "$agent"
}

maybe_setup_local_llm_duckduckgo_mcp() {
  if [[ "$AGENT" != "local-llm" ]]; then
    return 0
  fi
  if [[ -f "$LOCAL_LLM_DDG_MCP_FILE" ]]; then
    return 0
  fi
  if ! resolve_setup_dir; then
    echo "Warning: setup scripts not found; skipping DuckDuckGo MCP setup." >&2
    return 0
  fi
  if ! LOGLM_LOCAL_LLM_DDG_MCP_MARKER="$LOCAL_LLM_DDG_MCP_FILE" "$SETUP_DIR/agent-local-llm.sh"; then
    echo "Warning: DuckDuckGo MCP setup did not complete. local-llm can continue without web search." >&2
  fi
}

antigravity_command() {
  if command -v agy > /dev/null 2>&1; then
    printf '%s\n' "agy"
    return 0
  fi
  if command -v antigravity > /dev/null 2>&1; then
    printf '%s\n' "antigravity"
    return 0
  fi
  return 1
}

normalize_local_llm_url() {
  local url="$1"
  url="${url%/}"
  if [[ -z "$url" ]]; then
    url="http://127.0.0.1:8080"
  fi
  printf '%s\n' "$url"
}

configure_local_llm_url() {
  local current="${LOGLM_LOCAL_LLM_URL:-}"
  if [[ -z "$current" && -f "$LOCAL_LLM_FILE" ]]; then
    current="$(head -n 1 "$LOCAL_LLM_FILE" | tr -d '[:space:]')"
  fi
  current="$(normalize_local_llm_url "${current:-http://127.0.0.1:8080}")"

  if [[ "${LOGLM_LOCAL_LLM_URL_SET:-0}" == "1" ]]; then
    LOCAL_LLM_URL="$current"
    printf '%s\n' "$LOCAL_LLM_URL" > "$LOCAL_LLM_FILE"
    return
  fi

  if [[ ! -f "$LOCAL_LLM_FILE" ]]; then
    printf 'Local LLM gateway URL [%s]: ' "$current"
    local answer
    read -r answer
    LOCAL_LLM_URL="$(normalize_local_llm_url "${answer:-$current}")"
    printf '%s\n' "$LOCAL_LLM_URL" > "$LOCAL_LLM_FILE"
  else
    LOCAL_LLM_URL="$current"
  fi
}

configure_local_llm_model() {
  local current="${LOGLM_LOCAL_LLM_MODEL:-}"
  if [[ -z "$current" && -f "$LOCAL_LLM_MODEL_FILE" ]]; then
    current="$(head -n 1 "$LOCAL_LLM_MODEL_FILE" | tr -d '[:space:]')"
  fi

  if [[ "${LOGLM_LOCAL_LLM_MODEL_SET:-0}" == "1" ]]; then
    LOCAL_LLM_MODEL="$current"
    printf '%s\n' "$LOCAL_LLM_MODEL" > "$LOCAL_LLM_MODEL_FILE"
    return
  fi

  if [[ -z "$current" ]]; then
    current="$(discover_local_llm_model "$LOCAL_LLM_URL" || true)"
    if [[ -n "$current" ]]; then
      printf '%s\n' "$current" > "$LOCAL_LLM_MODEL_FILE"
      echo "Detected local LLM model: $current" >&2
    else
      echo "Warning: could not detect local LLM model from $LOCAL_LLM_URL/v1/models; launching without --model." >&2
    fi
  fi

  LOCAL_LLM_MODEL="$current"
}

discover_local_llm_model() {
  local url="$1"
  command -v curl > /dev/null 2>&1 || return 1
  curl -fsS --max-time 2 "$url/v1/models" 2>/dev/null | perl -MJSON::PP -0777 -e '
    my $text = <STDIN>;
    my $data = eval { decode_json($text) } or exit 1;
    if (ref($data->{data}) eq "ARRAY") {
      for my $item (@{$data->{data}}) {
        next unless ref($item) eq "HASH";
        if (defined $item->{id} && $item->{id} ne "") {
          print "$item->{id}\n";
          exit 0;
        }
      }
    }
    exit 1;
  '
}

check_local_llm_endpoint() {
  local url="$1"
  if ! command -v curl > /dev/null 2>&1; then
    echo "Warning: curl not found; skipping local LLM endpoint check." >&2
    return 0
  fi
  if curl -fsS --max-time 2 "$url/health" > /dev/null 2>&1; then
    return 0
  fi
  if curl -fsS --max-time 2 "$url/" > /dev/null 2>&1; then
    return 0
  fi
  echo "Error: local LLM gateway is not reachable: $url" >&2
  echo "Start llama-server separately, then rerun loglm." >&2
  echo "Example: llama-server -m /path/to/model.gguf --ctx-size 32768 --host 127.0.0.1 --port 8080" >&2
  return 1
}

exclude_local_claude_settings_from_git() {
  local git_dir exclude_file
  git_dir="$(git rev-parse --git-dir 2>/dev/null || true)"
  [[ -n "$git_dir" ]] || return 0
  exclude_file="$git_dir/info/exclude"
  [[ -f "$exclude_file" && -w "$exclude_file" ]] || return 0
  if ! grep -Fqx ".claude/settings.local.json" "$exclude_file"; then
    printf '\n# Added by loglm local-llm\n.claude/settings.local.json\n' >> "$exclude_file"
  fi
}

ensure_local_llm_claude_settings() {
  local settings tmp
  settings="$WORK_DIR/.claude/settings.local.json"
  mkdir -p "$WORK_DIR/.claude"
  if [[ -x /usr/bin/mktemp ]]; then
    tmp="$(/usr/bin/mktemp "${TMPDIR:-/tmp}/loglm-claude-settings.XXXXXX")"
  else
    tmp="$(mktemp "${TMPDIR:-/tmp}/loglm-claude-settings.XXXXXX")"
  fi

  if [[ -f "$settings" ]]; then
    if ! perl -MJSON::PP -0777 -e '
      my $path = shift;
      my $text = <STDIN>;
      my $data = decode_json($text);
      $data->{env} = {} unless ref($data->{env}) eq "HASH";
      $data->{env}->{CLAUDE_CODE_ATTRIBUTION_HEADER} = "0";
      my $json = JSON::PP->new->canonical->pretty->encode($data);
      print $json;
    ' "$settings" < "$settings" > "$tmp"; then
      rm -f "$tmp"
      echo "Warning: could not update $settings; invalid JSON may disable local-llm KV-cache optimization." >&2
      return 0
    fi
  else
    cat > "$tmp" <<'EOF'
{
   "env" : {
      "CLAUDE_CODE_ATTRIBUTION_HEADER" : "0"
   }
}
EOF
  fi

  mv "$tmp" "$settings"
  exclude_local_claude_settings_from_git
}

ensure_runtime_notes() {
  local agent="$1"

  if ! resolve_setup_dir; then
    return 0
  fi

  "$SETUP_DIR/agent-install.sh" runtime-notes --agent "$agent" --force --quiet || true
}

claude_has_history() {
  local encoded
  encoded="$(perl -MEncode=decode -e 'my $s = decode("UTF-8", shift); $s =~ s/[^A-Za-z0-9._-]/-/g; print $s' "$WORK_DIR")"
  compgen -G "$HOME/.claude/projects/$encoded/*.jsonl" > /dev/null 2>&1
}

hermes_has_history() {
  compgen -G "$HOME/.hermes/sessions/*" > /dev/null 2>&1 ||
    compgen -G "$HOME/.hermes/session*/*" > /dev/null 2>&1 ||
    compgen -G "$HOME/.hermes/profiles/*/sessions/*" > /dev/null 2>&1
}

is_running_under_script() {
  local pid ppid comm
  pid="$$"

  while :; do
    ppid="$(ps -o ppid= -p "$pid" | tr -d '[:space:]')"
    if [[ -z "$ppid" || "$ppid" == "0" ]]; then
      return 1
    fi

    comm="$(ps -o comm= -p "$ppid" | awk '{print $1}')"
    if [[ "$comm" == "script" ]]; then
      return 0
    fi

    pid="$ppid"
  done
}

run_agent_subcommand() {
  local subcmd="$1"
  shift
  if ! resolve_setup_dir; then
    echo "Error: setup scripts not found." >&2
    echo "Expected '$SCRIPT_DIR/setup' or '$LOGLM_HOME/setup'." >&2
    echo "Reinstall loglm and try again." >&2
    exit 1
  fi

  AGENT="${LOGLM_CODING_AGENT:-}"
  # For install, enforce coding-agent selection first.
  if [[ "$subcmd" == "install" ]]; then
    local skip_select=0
    local explicit_agent=""
    local prev_arg=""
    for arg in "$@"; do
      if [[ "$arg" == "-h" || "$arg" == "--help" ]]; then
        skip_select=1
        break
      fi
      if [[ "$prev_arg" == "--agent" ]]; then
        explicit_agent="$arg"
      fi
      prev_arg="$arg"
    done

    if [[ "$skip_select" -eq 0 ]]; then
      if [[ -n "$explicit_agent" && "$explicit_agent" != "all" ]]; then
        AGENT="$explicit_agent"
      fi

      if [[ -n "$AGENT" ]]; then
        valid=0
        for a in "${SUPPORTED_AGENTS[@]}"; do
          [[ "$a" == "$AGENT" ]] && valid=1 && break
        done
        if [[ "$valid" -eq 0 ]]; then
          echo "Warning: unknown agent '$AGENT' from LOGLM_CODING_AGENT. Re-selecting." >&2
          AGENT=""
        fi
      fi

      if [[ -z "$AGENT" && ! -f "$AGENT_FILE" ]]; then
        select_agent
      elif [[ -z "$AGENT" ]]; then
        AGENT="$(cat "$AGENT_FILE")"
        valid=0
        for a in "${SUPPORTED_AGENTS[@]}"; do
          [[ "$a" == "$AGENT" ]] && valid=1 && break
        done
        if [[ "$valid" -eq 0 ]]; then
          echo "Warning: unknown agent '$AGENT' stored in $AGENT_FILE. Re-selecting." >&2
          select_agent
        fi
      fi
    fi
  elif [[ -f "$AGENT_FILE" ]]; then
    AGENT="$(cat "$AGENT_FILE")"
  fi

  case "$subcmd" in
    install)
      LOGLM_DEFAULT_PROMPT_AGENT="$AGENT" "$SETUP_DIR/agent-install.sh" "$subcmd" "$@"
      ;;
    list|remove|update)
      LOGLM_DEFAULT_PROMPT_AGENT="$AGENT" "$SETUP_DIR/agent-install.sh" "$subcmd" "$@"
      ;;
    *)
      echo "Error: unknown agent subcommand: $subcmd" >&2
      usage >&2
      exit 2
      ;;
  esac
}

POST_INSTALL_NEW=0

select_agent() {
  echo "Select AI coding agent:"
  local i=1
  for agent in "${SUPPORTED_AGENTS[@]}"; do
    printf "  %d) %s\n" "$i" "$agent"
    ((i++))
  done
  local choice
  while :; do
    printf "Enter number [1-%d]: " "${#SUPPORTED_AGENTS[@]}"
    read -r choice
    if [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#SUPPORTED_AGENTS[@]} )); then
      AGENT="${SUPPORTED_AGENTS[$((choice - 1))]}"
      printf '%s\n' "$AGENT" > "$AGENT_FILE"
      echo "Selected: $AGENT"
      return
    fi
    echo "Invalid choice. Please enter a number between 1 and ${#SUPPORTED_AGENTS[@]}."
  done
}

if (($# > 0)) && [[ "$1" == "agent" ]]; then
  shift
  if (($# == 0)); then
    usage >&2
    exit 2
  fi
  AGENT_SUBCMD="$1"
  AGENT_INSTALL_HELP=0
  if [[ "$AGENT_SUBCMD" == "install" ]]; then
    for arg in "$@"; do
      if [[ "$arg" == "-h" || "$arg" == "--help" ]]; then
        AGENT_INSTALL_HELP=1
        break
      fi
    done
  fi
  run_agent_subcommand "$@"
  if [[ "$AGENT_SUBCMD" != "install" ]]; then
    exit 0
  fi
  if [[ "$AGENT_INSTALL_HELP" -eq 1 ]]; then
    exit 0
  fi
  if [[ "${LOGLM_AGENT_INSTALL_NO_LAUNCH:-0}" == "1" ]]; then
    exit 0
  fi
  POST_INSTALL_NEW=1
  set --
fi

FORCE_NEW=0
CHOOSE_RESUME=0
DANGEROUS_MODE=0
CHOOSE_AGENT=0
DAILY_LOG=0
LOCAL_LLM_URL=""
LOCAL_LLM_MODEL=""
LOGLM_LOCAL_LLM_URL_SET=0
LOGLM_LOCAL_LLM_MODEL_SET=0

while (($# > 0)); do
  case "$1" in
    --new)
      FORCE_NEW=1
      shift
      ;;
    --resume)
      CHOOSE_RESUME=1
      shift
      ;;
    --agent)
      CHOOSE_AGENT=1
      shift
      ;;
    --local-llm-url)
      if (($# < 2)); then
        echo "Error: --local-llm-url requires a value." >&2
        exit 2
      fi
      LOGLM_LOCAL_LLM_URL="$(normalize_local_llm_url "$2")"
      LOGLM_LOCAL_LLM_URL_SET=1
      shift 2
      ;;
    --local-llm-model)
      if (($# < 2)); then
        echo "Error: --local-llm-model requires a value." >&2
        exit 2
      fi
      LOGLM_LOCAL_LLM_MODEL="$2"
      LOGLM_LOCAL_LLM_MODEL_SET=1
      shift 2
      ;;
    --daily-log)
      DAILY_LOG=1
      shift
      ;;
    -X|--dangerous)
      DANGEROUS_MODE=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    -v|--version)
      show_version
      exit 0
      ;;
    *)
      echo "Error: unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

mkdir -p "$LOG_DIR"

if [[ "$POST_INSTALL_NEW" -eq 1 ]]; then
  FORCE_NEW=1
fi

if [[ "$FORCE_NEW" -eq 1 && "$CHOOSE_RESUME" -eq 1 ]]; then
  echo "Error: --new and --resume cannot be used together." >&2
  exit 2
fi

if [[ "$CHOOSE_AGENT" -eq 1 || ! -f "$AGENT_FILE" ]]; then
  select_agent
else
  AGENT="$(cat "$AGENT_FILE")"
  valid=0
  for a in "${SUPPORTED_AGENTS[@]}"; do
    [[ "$a" == "$AGENT" ]] && valid=1 && break
  done
  if [[ "$valid" -eq 0 ]]; then
    echo "Warning: unknown agent '$AGENT' stored in $AGENT_FILE. Re-selecting." >&2
    select_agent
  fi
fi

ensure_agent_installed "$AGENT"

if [[ "$AGENT" == "local-llm" ]]; then
  configure_local_llm_url
  configure_local_llm_model
  ensure_local_llm_claude_settings
  maybe_setup_local_llm_duckduckgo_mcp
  check_local_llm_endpoint "$LOCAL_LLM_URL"
fi

ensure_runtime_notes "$AGENT"

if [[ "$DAILY_LOG" -eq 1 ]]; then
  LOG_FILE="$LOG_DIR/loglm-${AGENT}-log-${TODAY_LOCAL}.txt"
else
  LOG_FILE="$LOG_DIR/loglm-${AGENT}-log-${NOW_LOCAL}-pid$$.txt"
fi

case "$AGENT" in
  codex)
    BASE_CMD=(codex)
    if [[ "$DANGEROUS_MODE" -eq 1 ]]; then
      BASE_CMD+=(--dangerously-bypass-approvals-and-sandbox)
    fi
    if [[ "$FORCE_NEW" -eq 1 ]]; then
      AGENT_CMD=("${BASE_CMD[@]}" --search)
    elif [[ "$CHOOSE_RESUME" -eq 1 ]]; then
      AGENT_CMD=("${BASE_CMD[@]}" resume)
    else
      AGENT_CMD=("${BASE_CMD[@]}" resume --last)
    fi
    ;;

  claude)
    BASE_CMD=(claude)
    if [[ "$DANGEROUS_MODE" -eq 1 ]]; then
      BASE_CMD+=(--dangerously-skip-permissions)
    fi
    if [[ "$FORCE_NEW" -eq 1 ]]; then
      AGENT_CMD=("${BASE_CMD[@]}")
    elif [[ "$CHOOSE_RESUME" -eq 1 ]]; then
      AGENT_CMD=("${BASE_CMD[@]}" --resume)
    elif claude_has_history; then
      AGENT_CMD=("${BASE_CMD[@]}" --continue)
    else
      AGENT_CMD=("${BASE_CMD[@]}")
    fi
    ;;

  local-llm)
    BASE_CMD=(claude)
    if [[ -n "$LOCAL_LLM_MODEL" ]]; then
      BASE_CMD+=(--model "$LOCAL_LLM_MODEL")
    fi
    if [[ "$DANGEROUS_MODE" -eq 1 ]]; then
      BASE_CMD+=(--dangerously-skip-permissions)
    fi
    if [[ "$FORCE_NEW" -eq 1 ]]; then
      AGENT_CMD=("${BASE_CMD[@]}")
    elif [[ "$CHOOSE_RESUME" -eq 1 ]]; then
      AGENT_CMD=("${BASE_CMD[@]}" --resume)
    elif claude_has_history; then
      AGENT_CMD=("${BASE_CMD[@]}" --continue)
    else
      AGENT_CMD=("${BASE_CMD[@]}")
    fi
    AGENT_CMD=(
      env
      "ANTHROPIC_BASE_URL=$LOCAL_LLM_URL"
      "ANTHROPIC_AUTH_TOKEN=${LOGLM_LOCAL_LLM_AUTH_TOKEN:-loglm-local-llm}"
      "CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=1"
      "${AGENT_CMD[@]}"
    )
    ;;

  antigravity)
    BASE_CMD=("$(antigravity_command)")
    if [[ "$DANGEROUS_MODE" -eq 1 ]]; then
      echo "Warning: --dangerous is not mapped for Antigravity yet; launching normally." >&2
    fi
    if [[ "$FORCE_NEW" -eq 1 ]]; then
      AGENT_CMD=("${BASE_CMD[@]}")
    elif [[ "$CHOOSE_RESUME" -eq 1 ]]; then
      AGENT_CMD=("${BASE_CMD[@]}" -c)
    else
      AGENT_CMD=("${BASE_CMD[@]}" -c)
    fi
    ;;

  openclaw)
    BASE_CMD=(openclaw tui --local)
    if [[ "$DANGEROUS_MODE" -eq 1 ]]; then
      echo "Warning: --dangerous is not mapped for OpenClaw yet; launching normally." >&2
    fi
    if [[ "$FORCE_NEW" -eq 1 ]]; then
      AGENT_CMD=("${BASE_CMD[@]}" --session "loglm-${NOW_LOCAL}-pid$$")
    elif [[ "$CHOOSE_RESUME" -eq 1 ]]; then
      AGENT_CMD=("${BASE_CMD[@]}")
    else
      AGENT_CMD=("${BASE_CMD[@]}")
    fi
    ;;

  hermes)
    BASE_CMD=(hermes)
    if [[ "$DANGEROUS_MODE" -eq 1 ]]; then
      echo "Warning: --dangerous is not mapped for Hermes Agent yet; launching normally." >&2
    fi
    if [[ "$FORCE_NEW" -eq 1 ]]; then
      AGENT_CMD=("${BASE_CMD[@]}")
    elif [[ "$CHOOSE_RESUME" -eq 1 ]]; then
      AGENT_CMD=("${BASE_CMD[@]}" --continue)
    elif hermes_has_history; then
      AGENT_CMD=("${BASE_CMD[@]}" --continue)
    else
      AGENT_CMD=("${BASE_CMD[@]}")
    fi
    ;;
esac

if is_running_under_script; then
  exec "${AGENT_CMD[@]}"
fi

RUN_START_LOCAL="$(date '+%Y-%m-%d %H:%M:%S %z')"
{
  printf '\n===== loglm start [%s]: %s =====\n' "$AGENT" "$RUN_START_LOCAL"
} >> "$LOG_FILE"

SCRIPT_OPTS=(-q -a)
SCRIPT_HELP="$(script -h 2>&1 || true)"

if printf '%s' "$SCRIPT_HELP" | grep -Eq -- '(^|[[:space:]])-F([,[:space:]]|$)'; then
  SCRIPT_OPTS+=(-F)
elif printf '%s' "$SCRIPT_HELP" | grep -Eq -- '(^|[[:space:]])-f([,[:space:]]|$)'; then
  SCRIPT_OPTS+=(-f)
fi

if printf '%s' "$SCRIPT_HELP" | grep -Eq -- '(^|[[:space:]])-c,|--command([[:space:]]|=)'; then
  AGENT_CMD_STRING="$(printf '%q ' "${AGENT_CMD[@]}")"
  AGENT_CMD_STRING="${AGENT_CMD_STRING% }"
  exec script "${SCRIPT_OPTS[@]}" "$LOG_FILE" -c "exec $AGENT_CMD_STRING"
else
  exec script "${SCRIPT_OPTS[@]}" "$LOG_FILE" "${AGENT_CMD[@]}"
fi
